[Unit]
Description=ct-hunter firehose watcher (Certificate Transparency monitoring)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Proyectos/CTI
ExecStart=/usr/bin/uv run ct-hunter-hunt
Restart=on-failure
RestartSec=5
# `uv run` forwards SIGTERM to the child, which exits with code 143; without
# this, a clean `systemctl stop` shows up as "failed" instead of "stopped".
SuccessExitStatus=143
# data/hunt.log is now written and rotated directly by Python's
# logging.handlers.RotatingFileHandler (see logging_setup.py), not by
# systemd appending stdout/stderr to it; StandardOutput/StandardError are
# left at their default (journal), viewable with
# `journalctl --user -u ct-hunter-hunt.service`.

[Install]
WantedBy=default.target
