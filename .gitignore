.claude

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# uv
.python-version.local

# Project data (local sqlite db, not versioned). Includes the WAL-mode
# sidecar files (-wal/-shm), which contain raw, uncheckpointed page data
# from the live database, absolute local paths, real detected domains,
# and everything else a plain .db file would have, missing these was a
# real leak once WAL mode was turned on, see the conversation.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite3

# Runtime artifacts del proceso ct-hunter-hunt lanzado desde la UI
data/hunt.pid
data/hunt_status*
data/hunt.log
data/streamlit.log

# Screenshots capturados (referencia + candidatos) — binarios, se regeneran
data/screenshots/

# Env / secrets
.env

# Already tracked, this has no effect yet, see the conversation for why
docs/architecture.md

# OS
.DS_Store
